# Copy to deploy/.env or repository-root .env. Use different random secrets per install.
WMIND_VERSION=latest
HTTP_PORT=80
TZ=Asia/Shanghai
WMIND_LOG_LEVEL=info
WMIND_JWT_SECRET=replace-with-at-least-32-random-bytes

# Dedicated proxy network. If this subnet conflicts with a VPN/LAN, change ALL
# four addresses together. Existing deployments may need to recreate the network.
WMIND_NETWORK_SUBNET=172.31.254.0/29
WMIND_API_IP=172.31.254.2
WMIND_WEB_IP=172.31.254.3
WMIND_DB_IP=172.31.254.4
# Defaults to WMIND_WEB_IP. Add only exact upstream proxy addresses you control;
# never trust all public/private networks. Leave empty for the default.
WMIND_TRUSTED_PROXIES=

# Optional stable encryption key (32+ bytes) for 2FA, AI config and legacy share ciphertext.
# If empty, uses JWT secret; keep the effective key stable and backed up.
WMIND_2FA_ENCRYPTION_KEY=

# Seed admin: used only when the users table is empty.
WMIND_ADMIN_EMAIL=admin@example.com
WMIND_ADMIN_PASSWORD=replace-before-first-deploy

# PostgreSQL compose only. Keep the password URL-safe (letters/numbers) to
# avoid URL escaping in WMIND_DATABASE_URL.
POSTGRES_USER=wmind
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=wmind
WMIND_DB_MAX_CONNS=20
