# Copy to deploy/.env or repository-root .env. Use different random secrets per install.
WMIND_VERSION=latest
HTTP_PORT=80
TZ=Asia/Shanghai
WMIND_LOG_LEVEL=info
WMIND_JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional stable secrets encryption key (32+ bytes), also used for share passwords.
# If empty, derived from JWT secret; keep the effective key stable and backed up.
WMIND_2FA_ENCRYPTION_KEY=

# Seed admin: used only when the users table is empty.
WMIND_ADMIN_EMAIL=admin@example.com
WMIND_ADMIN_PASSWORD=replace-before-first-deploy

# PostgreSQL compose only. Keep the password URL-safe (letters/numbers) to
# avoid URL escaping in WMIND_DATABASE_URL.
POSTGRES_USER=wmind
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=wmind
WMIND_DB_MAX_CONNS=20
