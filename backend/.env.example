# ── 本地开发配置 ─────────────────────────────────────────
#
# 用法：cp .env.example .env  然后填好 WMIND_JWT_SECRET。
#
# 本地开发默认使用 SQLite——数据库就是一个文件，不需要启动任何数据库服务，
# 也不需要 Docker。.env 已被 .gitignore 忽略，不要提交。

# ── 运行环境 ─────────────────────────────────────────────
WMIND_ENV=development
WMIND_ADDR=:8080
WMIND_LOG_LEVEL=debug

# ── 密钥（必填）──────────────────────────────────────────
# 必须 ≥ 32 字节，否则启动即拒绝。生成：openssl rand -base64 48
WMIND_JWT_SECRET=

# 可选独立 2FA 加密密钥，至少 32 字节；留空从 JWT 密钥派生。
# 首次启用后必须保持稳定并备份；变更有效密钥会使验证器密钥无法解密。
WMIND_2FA_ENCRYPTION_KEY=

# ── 数据库（默认 SQLite）─────────────────────────────────
WMIND_DB_DRIVER=sqlite
WMIND_SQLITE_PATH=./data/wmind.db
WMIND_AUTO_MIGRATE=true

# 改用 PostgreSQL 时，把上面两行换成：
# WMIND_DB_DRIVER=postgres
# WMIND_DATABASE_URL=postgres://wmind:wmind@localhost:5432/wmind?sslmode=disable
# WMIND_DB_MAX_CONNS=20

# ── 文件存储（一期只用本地磁盘）──────────────────────────
WMIND_STORAGE_DRIVER=local
WMIND_STORAGE_DIR=./data/uploads
WMIND_UPLOAD_MAX_MB=10

# ── 跨域：Vite 开发服务器 ────────────────────────────────
WMIND_CORS_ORIGINS=http://localhost:5173

# ── 首次启动创建的管理员（仅 users 表为空时生效）──────────
# 上线前务必改掉；生产环境不要用示例值。
WMIND_ADMIN_EMAIL=admin@wmind.local
WMIND_ADMIN_PASSWORD=change-me-please
